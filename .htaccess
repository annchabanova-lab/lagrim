RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 301 redirects for alternate domains
RewriteCond %{HTTP_HOST} ^(www\.)?grimouilliere\.fr$ [NC]
RewriteRule ^(.*)$ https://lagrimouilliere.fr/$1 [L,R=301]

RewriteCond %{HTTP_HOST} ^(www\.)?grimouillere\.fr$ [NC]
RewriteRule ^(.*)$ https://lagrimouilliere.fr/$1 [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.lagrimouilliere\.fr$ [NC]
RewriteRule ^(.*)$ https://lagrimouilliere.fr/$1 [L,R=301]

# Serve PHP files for dynamic pages (URLs stay .html)
RewriteRule ^la-maison\.html$ la-maison.php [L]
RewriteRule ^chambres\.html$ chambres.php [L]
RewriteRule ^autour\.html$ autour.php [L]
RewriteRule ^tarifs\.html$ tarifs.php [L]
RewriteRule ^contact\.html$ contact.php [L]
RewriteRule ^faq\.html$ faq.php [L]
RewriteRule ^mentions-legales\.html$ mentions-legales.php [L]

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Brotli compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
